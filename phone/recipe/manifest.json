{
  "id": "com.dynag.recipe.phone",
  "name": "GM Recipe",
  "version": "1.0.0",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "permissions": [
    { "name": "storage", "required": true },
    { "name": "device.info", "required": true },
    { "name": "device.messaging", "required": true, "scope": { "channels": [21059, 21057] } },
    { "name": "device.events", "required": false, "scope": { "types": ["connection"] } }
  ],
  "deviceRequirements": {
    "preferredPluginId": "com.dynag.recipe.glass",
    "requiredPluginId": "com.dynag.recipe.glass",
    "minPluginVersion": "1",
    "protocols": [
      { "id": "gm.recipe", "minVersion": "1.0" }
    ]
  },
  "schemaVersion": 2,
  "permissionPolicyVersion": 1
}
